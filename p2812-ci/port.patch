index 00000000..876ef0bb
--- /dev/null
+++ b/tools/p2812/ci_inputs.py
@@ -0,0 +1,54 @@
+#!/usr/bin/env python3
+"""Fetch hash-pinned public CI inputs; invoked before the offline builds."""
+import argparse
+import hashlib
+import json
+import os
+from pathlib import Path
+import urllib.parse
+import urllib.request
+
+KIT = Path(__file__).resolve().parent
+
+
+def download(url, path, expected):
+    if urllib.parse.urlparse(url).scheme != 'https':
+        raise ValueError('HTTPS download URL required')
+    digest = hashlib.sha256()
+    with urllib.request.urlopen(url, timeout=60) as response, path.open('xb') as output:
+        if urllib.parse.urlparse(response.url).scheme != 'https':
+            raise ValueError('HTTPS redirect required')
+        while True:
+            block = response.read(1024 * 1024)
+            if not block:
+                break
+            output.write(block)
+            digest.update(block)
+    if digest.hexdigest() != expected:
+        raise RuntimeError('Downloaded input SHA256 differs: ' + path.name)
+
+
+def main():
+    parser = argparse.ArgumentParser()
+    parser.add_argument('destination', type=Path)
+    parser.add_argument('--no-builder', action='store_true', help='Build the environment from the CI recipe instead')
+    args = parser.parse_args()
+    lock = json.loads((KIT / 'baseline.json').read_text())
+    builder_url = os.environ.get('P2812_BUILDER_ARCHIVE_URL', '')
+    if not args.no_builder and not builder_url:
+        raise RuntimeError('Publish the frozen builder archive and set repository variable P2812_BUILDER_ARCHIVE_URL first')
+    args.destination.mkdir(parents=True, exist_ok=False)
+    if not args.no_builder:
+        download(builder_url, args.destination / 'builder.tar', lock['builder_archive_sha256'])
+    with urllib.request.urlopen('https://pypi.org/pypi/unicorn/2.1.4/json', timeout=60) as stream:
+        metadata = json.load(stream)
+    expected = lock['unicorn_wheel']
+    records = [r for r in metadata['urls'] if r['filename'] == expected['filename']]
+    if len(records) != 1 or records[0]['digests']['sha256'] != expected['sha256']:
+        raise RuntimeError('Public wheel metadata differs from the pinned input')
+    download(records[0]['url'], args.destination / 'unicorn.whl', expected['sha256'])
+    print('PASS: public Linux wheel SHA256 verified; builder=' + ('source-built separately' if args.no_builder else 'archive verified'))
+
+
+if __name__ == '__main__':
+    main()
diff --git a/tools/p2812/compare.py b/tools/p2812/compare.py
new file mode 100644
index 00000000..51b39e94
--- /dev/null
+++ b/tools/p2812/compare.py
@@ -0,0 +1,49 @@
+#!/usr/bin/env python3
+"""Compare actual outputs of two independent completed baseline builds."""
+import argparse
+import hashlib
+import json
+from pathlib import Path
+
+
+def sha(path):
+    return hashlib.sha256(path.read_bytes()).hexdigest()
+
+
+def main():
+    parser = argparse.ArgumentParser()
+    parser.add_argument('first', type=Path)
+    parser.add_argument('second', type=Path)
+    args = parser.parse_args()
+    lock = json.loads((Path(__file__).parent / 'baseline.json').read_text())
+    reports = [json.loads((p / 'summary.json').read_text()) for p in [args.first, args.second]]
+    if not all(r['passed'] for r in reports):
+        raise RuntimeError('Both complete builds must pass')
+    for key in ['source_commit', 'source_tree', 'source_archive_sha256', 'builder_image_id', 'unicorn_wheel_sha256']:
+        if reports[0][key] != reports[1][key]:
+            raise RuntimeError('Build inputs differ: ' + key)
+    stable = set(lock['expected_outputs']) | {
+        'main/u-boot', 'main/u-boot.bin', 'main/.config', 'main/System.map',
+        'package/u-boot.bin.lzo', 'early/tpl-padded.bin', 'early/generated.h',
+        'native-tests.json', 'mips-tests.json', 'audit.json', 'status.txt',
+    }
+    values = {}
+    for name in sorted(stable):
+        actual = [sha(p / 'results' / name) for p in [args.first, args.second]]
+        if actual[0] != actual[1]:
+            raise RuntimeError('Clean builds differ: ' + name)
+        if name in lock['expected_outputs'] and actual[0] != lock['expected_outputs'][name]:
+            raise RuntimeError('Historical reference differs: ' + name)
+        values[name] = actual[0]
+    report = {'passed': True, 'independent_builds': 2,
+              'source_commit': reports[0]['source_commit'],
+              'compared_outputs': len(values), 'historical_reference_matches': 7,
+              'outputs_sha256': values, 'hardware_access': False}
+    output = args.second / 'reproducibility.json'
+    with output.open('x') as stream:
+        stream.write(json.dumps(report, indent=2) + '\n')
+    print('PASS: %d outputs identical in two clean builds; all 7 historical binary references match' % len(values))
+
+
+if __name__ == '__main__':
+    main()
