diff --git a/tools/p2812/early/memory.c b/tools/p2812/early/memory.c
new file mode 100644
index 00000000..ffb7a07f
--- /dev/null
+++ b/tools/p2812/early/memory.c
@@ -0,0 +1,24 @@
+/* SPDX-License-Identifier: GPL-2.0+ */
+#include "stats.h"
+#define CCR(n) (0xbf401000u+(n)*16)
+#define TEST_BASE 0xa0400000u
+u32 memory_capacity(void) {
+ u32 banks=(rd32(CCR(3))&1)?8:4,cs=(rd32(CCR(8))>>24)&3;
+ u32 col=(rd32(CCR(15))>>24)&15,row=rd32(CCR(16))&15,c11=rd32(CCR(11));
+ u32 cr=(c11>>24)&7,rr=c11&7;
+ if(cs!=1||col<=cr||row<=rr)return 0;
+ col-=cr;row-=rr;if(col+row>24)return 0;
+ return (1u<<(col+row))*banks*2u;
+}
+int memory_check(void) {
+ volatile u32 *p=(void *)TEST_BASE;u32 pass,i,v;
+ for(pass=0;pass<4;pass++){
+  for(i=0;i<0x4000;i++)p[i]=pass==0?0:pass==1?~0u:pass==2?TEST_BASE+i*4:~(TEST_BASE+i*4);
+  for(i=0;i<0x4000;i++){
+   v=pass==0?0:pass==1?~0u:pass==2?TEST_BASE+i*4:~(TEST_BASE+i*4);
+   if(p[i]!=v)return E_MEMORY;
+   B[B_MEMORY_WORDS]++;
+  }
+ }
+ return 0;
+}
diff --git a/tools/p2812/early/nand.c b/tools/p2812/early/nand.c
new file mode 100644
index 00000000..e717504c
--- /dev/null
+++ b/tools/p2812/early/nand.c
@@ -0,0 +1,76 @@
+/* SPDX-License-Identifier: GPL-2.0+
+ * Register setup adapted from the tested modern Lantiq NAND RO port and
+ * Copyright (C) 2011-2013 Daniel Schwierzeck's Lantiq NAND driver.
+ * Fixed Samsung ec:f1:00:95:40 geometry; no write/erase/reset commands.
+ * Fixed physical boot partition: bad blocks cause failure, never a read
+ * from the adjacent environment/kernel partitions. ROM block is required
+ * good; no unproven ROM bad-block skip behaviour is assumed.
+ */
+#include "early.h"
+#include <linux/mtd/nand_ecc.h>
+volatile u32 early_corrected;
+static u8 pagebuf[2112];
+static void gpio_update(u32 off,u32 mask,int set) {
+ u32 a=0xbe100b00u+off,v=rd32(a);wr32(a,set?v|mask:v&~mask);
+}
+static void pin(u32 p,int output) {
+ u32 dir,a0,a1,od,mask=1u<<(p%16),base=0x10+(p/16)*0x30;
+ if(p>=48){dir=0xa8;a0=0xac;a1=0x64;od=0x34;}
+ else {dir=base+8;a0=base+12;a1=base+16;od=base+20;}
+ gpio_update(a0,mask,1);gpio_update(a1,mask,0);
+ gpio_update(od,mask,output);gpio_update(dir,mask,output);
+}
+int nand_setup(void) {
+ static const u8 expected[5]={0xec,0xf1,0,0x95,0x40};u32 i;
+ wr32(0xbf10201c,rd32(0xbf10201c)&~(1u<<10));
+ if(wait_bits(0xbf102020,1u<<10,0))return E_TIMEOUT;
+ pin(23,1);pin(24,1);pin(13,1);pin(48,0);pin(49,1);
+ wr32(EBU+0x24,0x14000031);wr32(EBU+0x64,0x0040d295);
+ wr32(EBU+0xb0,0x001005f3);
+ wr8(NAND|0x18,0x90);
+ if(wait_bits(EBU+0xb4,8,8))goto timeout;
+ wr8(NAND|0x14,0);
+ if(wait_bits(EBU+0xb4,8,8))goto timeout;
+ for(i=0;i<5;i++)if(rd8(NAND|0x10)!=expected[i]){
+  nand_release();return E_GEOMETRY;
+ }
+ nand_release();return 0;
+timeout:
+ nand_release();return E_TIMEOUT;
+}
+static int check_block(u32 block) {
+ u32 i;int rc;
+ for(i=0;i<2;i++){
+  rc=nand_raw_page(block*64+i,pagebuf,2112);if(rc)return rc;
+  if(pagebuf[2048]!=0xff)return E_BADBLOCK;
+ }
+ return 0;
+}
+int nand_page_ecc(u32 page,u8 *dst) {
+ u8 calc[3];u32 step;int rc;
+ if(page>=PART_END/PAGE_SIZE)return E_BOUNDS;
+ rc=nand_raw_page(page,pagebuf,2112);if(rc)return rc;
+ for(step=0;step<8;step++){
+  nand_calculate_ecc(0,pagebuf+step*256,calc);
+  rc=nand_correct_data(0,pagebuf+step*256,pagebuf+2048+40+step*3,calc);
+  if(rc<0)return E_ECC;
+  early_corrected+=(u32)rc;
+ }
+ memcpy(dst,pagebuf,2048);return 0;
+}
+int nand_read_exact(u32 offset,u32 bytes,u8 *dst) {
+ /* Page-aligned callers only; last page copies exactly the requested
+  * bytes. Scratch is disjoint from the corrected page ECC scratch. */
+ u8 data[2048];u32 n,block=~0u;int rc;
+ if(offset<MAIN_OFFSET || offset%PAGE_SIZE || bytes>PART_END-offset ||
+    offset>=PART_END)return E_BOUNDS;
+ while(bytes){
+  if(offset/0x20000!=block){
+   block=offset/0x20000;rc=check_block(block);if(rc)return rc;
+  }
+  rc=nand_page_ecc(offset/PAGE_SIZE,data);if(rc)return rc;
+  n=bytes<PAGE_SIZE?bytes:PAGE_SIZE;memcpy(dst,data,n);
+  offset+=PAGE_SIZE;dst+=n;bytes-=n;
+ }
+ return 0;
+}
diff --git a/tools/p2812/early/runtime.c b/tools/p2812/early/runtime.c
new file mode 100644
index 00000000..808ec884
--- /dev/null
+++ b/tools/p2812/early/runtime.c
@@ -0,0 +1,36 @@
+/* SPDX-License-Identifier: GPL-2.0+ */
+#include "early.h"
+void *memcpy(void *d,const void *s,size_t n) {
+ u8 *a=d; const u8 *b=s; while(n--) *a++=*b++; return d;
+}
+void *memset(void *d,int v,size_t n) {
+ u8 *a=d; while(n--) *a++=(u8)v; return d;
+}
+u32 crc32_bytes(const u8 *p,u32 n) {
+ u32 c=~0u,i; while(n--) {c^=*p++; for(i=0;i<8;i++) c=(c>>1)^(0xedb88320u&-(c&1));} return ~c;
+}
+u32 adler32_bytes(const u8 *p,u32 n) {
+ u32 a=1,b=0; while(n--) {a+=*p++; if(a>=65521)a-=65521; b+=a;if(b>=65521)b-=65521;} return (b<<16)|a;
+}
+int wait_bits(u32 a,u32 mask,u32 target) {
+ u32 n=WAIT_POLLS; do {if((rd32(a)&mask)==target)return 0;}while(--n); return E_TIMEOUT;
+}
+void nand_release(void) { wr32(EBU+0xb0,rd32(EBU+0xb0)&~0x100001u); }
+/* Only NAND READ0/READSTART and address cycles exist in this reader.
+ * Bootstrap inherits the ROM EBU setup, as in the historical small SPL.
+ * Four address cycles: 2 column + 2 row, fixed 128 MiB x8 geometry.
+ */
+int nand_raw_page(u32 page,u8 *dst,u32 length) {
+ u32 i; const u8 addr[4]={0,0,(u8)page,(u8)(page>>8)};
+ if(page>=65536 || length>2112)return E_BOUNDS;
+ wr32(EBU+0xb0,rd32(EBU+0xb0)|0x100001u);
+ wr8(NAND|0x18,0x00);
+ if(wait_bits(EBU+0xb4,8,8))goto timeout;
+ for(i=0;i<4;i++) {wr8(NAND|0x14,addr[i]);if(wait_bits(EBU+0xb4,8,8))goto timeout;}
+ wr8(NAND|0x18,0x30);
+ if(wait_bits(EBU+0xb4,8,8)||wait_bits(EBU+0xb4,1,1))goto timeout;
+ for(i=0;i<length;i++)dst[i]=rd8(NAND|0x10);
+ nand_release();return 0;
+timeout:
+ nand_release();return E_TIMEOUT;
+}
diff --git a/tools/p2812/early/soc.c b/tools/p2812/early/soc.c
new file mode 100644
index 00000000..4650a95c
--- /dev/null
+++ b/tools/p2812/early/soc.c
@@ -0,0 +1,68 @@
+/* SPDX-License-Identifier: GPL-2.0+
+ * VRX200 clock/DDR sequence adapted from cgu_init.S/mem_init.S,
+ * Copyright (C) 2010 Lantiq Deutschland GmbH
+ * Copyright (C) 2011-2013 Daniel Schwierzeck.
+ * Board DDR constants Copyright (C) 2013 Luka Perkov (vendor header).
+ * Diagnostic fork: record raw probes; reject out-of-range observations.
+ * DDR start/poll ordering is retained, not claimed to fix the variation.
+ * DDR geometry probing retains the historical alias tests. This is NOT
+ * a warm RAM test entry: it reinitialises DDR and destroys probe words.
+ */
+#include "early.h"
+#include "vendor/ddr_settings.h"
+#include "trace.h"
+#define CGU 0xbf103000u
+#define MC 0xbf401000u
+#define CCR(n) (MC+(n)*16)
+static const u32 ddr[]={
+ MC_CCR00_VALUE,MC_CCR01_VALUE,MC_CCR02_VALUE,MC_CCR03_VALUE,
+ MC_CCR04_VALUE,MC_CCR05_VALUE,MC_CCR06_VALUE,MC_CCR07_VALUE,
+ MC_CCR08_VALUE,MC_CCR09_VALUE,MC_CCR10_VALUE,MC_CCR11_VALUE,
+ MC_CCR12_VALUE,MC_CCR13_VALUE,MC_CCR14_VALUE,MC_CCR15_VALUE,
+ MC_CCR16_VALUE,MC_CCR17_VALUE,MC_CCR18_VALUE,MC_CCR19_VALUE,
+ MC_CCR20_VALUE,MC_CCR21_VALUE,MC_CCR22_VALUE,MC_CCR23_VALUE,
+ MC_CCR24_VALUE,MC_CCR25_VALUE,MC_CCR26_VALUE,MC_CCR27_VALUE,
+ MC_CCR28_VALUE,MC_CCR29_VALUE,MC_CCR30_VALUE,MC_CCR31_VALUE,
+ MC_CCR32_VALUE,MC_CCR33_VALUE,MC_CCR34_VALUE,MC_CCR35_VALUE,
+ MC_CCR36_VALUE,MC_CCR37_VALUE,MC_CCR38_VALUE,MC_CCR39_VALUE,
+ MC_CCR40_VALUE,MC_CCR41_VALUE,MC_CCR42_VALUE,MC_CCR43_VALUE,
+ MC_CCR44_VALUE,MC_CCR45_VALUE,MC_CCR46_VALUE,MC_CCR47_VALUE,
+ MC_CCR48_VALUE,MC_CCR49_VALUE,MC_CCR50_VALUE,MC_CCR51_VALUE,
+ MC_CCR52_VALUE,MC_CCR53_VALUE,MC_CCR54_VALUE,MC_CCR55_VALUE,
+ MC_CCR56_VALUE,MC_CCR57_VALUE,MC_CCR58_VALUE,MC_CCR59_VALUE,
+ MC_CCR60_VALUE,MC_CCR61_VALUE};
+static int ddr_start(void) {
+ wr32(CCR(7),rd32(CCR(7))|0x100);
+ if(wait_bits(CCR(47),1,1)||wait_bits(CCR(48),1,1))return E_DDR;
+ return 0;
+}
+int soc_init(void) {
+ u32 i,c3=MC_CCR03_VALUE,c11=MC_CCR11_VALUE;
+ /* Match the historical 500 MHz CPU / 250 MHz DDR config; no reset. */
+ if(rd32(CGU+0xc)!=0x12 || rd32(CGU+0x10)!=0x03010000) {
+  return E_CLOCK; /* clock.c owns the target; DDR never reprograms CGU. */
+ }
+ wr32(CCR(7),0);
+ for(i=0;i<62;i++)if(i<47||i>51)wr32(CCR(i),ddr[i]);
+ wr32(0xbf400430,4); /* Disable FPI bursts, retain AHB bursts. */
+ if(ddr_start())return E_DDR;
+ T[4]=rd32(CCR(47));T[5]=rd32(CCR(48));
+ if(!(T[4]&1) || !(T[5]&1))return E_DDR;
+ T[2]=1;
+ /* Historical 8-bank / row / column alias probe. */
+ wr32(0xa0000000,1);wr32(0xa0002000,0);
+ T[6]=rd32(0xa0000000);
+ if(T[6]>1)return E_PROBE;
+ if(!T[6])c3&=~1u;
+ T[2]=2;
+ wr32(0xa0000000,0);wr32(0xa8000000,1);wr32(0xa4000000,2);
+ T[7]=rd32(0xa0000000);
+ if(T[7]>2)return E_PROBE;
+ c11+=T[7];T[2]=3;
+ wr32(0xa0000000,0);wr32(0xa0000400,1);wr32(0xa0000200,2);
+ T[8]=rd32(0xa0000000);
+ if(T[8]>2)return E_PROBE;
+ c11+=T[8]<<24;T[9]=c3;T[10]=c11;T[2]=4;
+ wr32(CCR(7),0);wr32(CCR(3),c3);wr32(CCR(11),c11);
+ return ddr_start();
+}
diff --git a/tools/p2812/early/spl.c b/tools/p2812/early/spl.c
new file mode 100644
index 00000000..f60b0c10
--- /dev/null
+++ b/tools/p2812/early/spl.c
@@ -0,0 +1,35 @@
+/* SPDX-License-Identifier: GPL-2.0+
+ * Source-built ROM-loaded bootstrap, based on the 2015 Lantiq small SPL
+ * page-1 -> SRAM strategy. No DDR, data programming, erase or reset.
+ * TPL main+OOB is read and corrected with upstream Hamming 1/256 before
+ * the build-bound CRC gate. ROM first-page ECC behaviour is not emulated.
+ */
+#include "early.h"
+#include "generated.h"
+#include <linux/mtd/nand_ecc.h>
+void spl_fail(u32 code) __attribute__((noreturn,noinline,noclone));
+void spl_fail(u32 code) { wr32(SPL_ERROR,code);for(;;)__asm__ volatile("nop"); }
+void spl_main(void) {
+ u32 i,step,corrected=0;u8 calc[3],*page;int rc;u8 *dst=(u8 *)TPL_BASE;
+ wr32(SPL_CORRECTED,0);wr32(SPL_ERROR,0);
+ /* Guard before the first read; retain the ROM's NAND timing and pins. */
+ rc=ebu_prepare();if(rc)spl_fail((u32)rc);
+ for(i=0;i<TPL_BYTES/PAGE_SIZE;i++) {
+  page=dst+i*PAGE_SIZE;
+  /* OOB temporarily occupies the next 64 bytes, overwritten by the next
+   * page. Final spill BE228000..BE22803F is inside SRAM, below the stack.
+   * TPL execution/BSS clearing starts only after all pages and CRC pass. */
+  if(nand_raw_page(i+1,page,PAGE_SIZE+OOB_SIZE))spl_fail(E_TIMEOUT);
+  if(i==0 && page[PAGE_SIZE]!=0xff)spl_fail(E_BADBLOCK);
+  for(step=0;step<8;step++) {
+   nand_calculate_ecc(0,page+step*256,calc);
+   rc=nand_correct_data(0,page+step*256,page+PAGE_SIZE+40+step*3,calc);
+   if(rc<0)spl_fail(E_ECC);
+   corrected+=(u32)rc;
+  }
+  wr32(SPL_CORRECTED,corrected);
+ }
+ if(crc32_bytes(dst,TPL_BYTES)!=TPL_CRC)spl_fail(E_TPL_CRC);
+ ((void (*)(void))TPL_BASE)();
+ spl_fail(E_TPL_CRC);
+}
diff --git a/tools/p2812/early/spl.lds b/tools/p2812/early/spl.lds
new file mode 100644
index 00000000..04715bad
--- /dev/null
+++ b/tools/p2812/early/spl.lds
@@ -0,0 +1,14 @@
+/* SPDX-License-Identifier: GPL-2.0+ */
+OUTPUT_ARCH(mips)
+ENTRY(_start)
+SECTIONS {
+ . = 0xbe220000;
+ .text : { *(.text.entry) *(.text*) }
+ .rodata : { *(.rodata*) }
+ .data : { *(.data*) }
+ __image_end = .;
+ .bss (NOLOAD) : { *(.bss*) *(COMMON) }
+ ASSERT(SIZEOF(.bss) == 0, "Bootstrap must not depend on zeroed BSS")
+ ASSERT(__image_end <= 0xbe2207e8, "ROM commands + bootstrap exceed first page")
+ /DISCARD/ : { *(.MIPS.abiflags) *(.reginfo) *(.pdr) *(.comment) *(.note*) *(.eh_frame*) *(.gnu*) }
+}
diff --git a/tools/p2812/early/start.S b/tools/p2812/early/start.S
new file mode 100644
index 00000000..6a3970c3
--- /dev/null
+++ b/tools/p2812/early/start.S
@@ -0,0 +1,60 @@
+/* SPDX-License-Identifier: GPL-2.0+ */
+ .set noreorder
+ .section .text.entry,"ax"
+ .globl _start
+_start:
+ /* SRAM code/stack are uncached. Interrupts remain disabled throughout. */
+ mfc0 $8,$12
+ li $9,~1
+ and $8,$8,$9
+ mtc0 $8,$12
+ ehb
+ li $sp,0xbe22f000
+ addiu $sp,$sp,-32
+#ifdef BUILD_SPL
+ la $25,spl_main
+#else
+ la $8,__bss_start
+ la $9,__bss_end
+1:
+ beq $8,$9,2f
+ nop
+ sw $zero,0($8)
+ b 1b
+ addiu $8,$8,4
+2:
+ la $25,tpl_main
+#endif
+ jr $25
+ nop
+#ifndef BUILD_SPL
+ .section .text.handoff,"ax"
+ .globl handoff
+handoff:
+ /* All TPL buffers and output use KSEG1; main performs its own tested
+  * cache reset. Invalidate both 32 KiB primary tag arrays before entry.
+  * Constants match P2812 34Kc's tested 32-byte lines. No writeback of
+  * undefined cold cache contents. Cache physics is outside the model.
+  */
+ mtc0 $zero,$28,0
+ mtc0 $zero,$28,2
+ ehb
+ li $8,0x80000000
+ li $9,0x80008000
+3:
+ cache 0x08,0($8)
+ cache 0x09,0($8)
+ addiu $8,$8,32
+ bne $8,$9,3b
+ nop
+ sync
+ mfc0 $8,$16
+ li $9,~7
+ and $8,$8,$9
+ ori $8,$8,3
+ mtc0 $8,$16
+ ehb
+ li $25,0xa0100000
+ jr $25
+ nop
+#endif
diff --git a/tools/p2812/early/stats.h b/tools/p2812/early/stats.h
new file mode 100644
index 00000000..26cc9974
--- /dev/null
