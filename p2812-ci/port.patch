+++ b/tools/p2812/early/early.h
@@ -0,0 +1,53 @@
+/* SPDX-License-Identifier: GPL-2.0+ */
+#ifndef P2812_EARLY_H
+#define P2812_EARLY_H
+#include <stddef.h>
+#include <stdint.h>
+typedef uint8_t u8;
+typedef uint16_t u16;
+typedef uint32_t u32;
+#define TPL_BASE 0xbe220800u
+#define TPL_BYTES 0x7800u
+#define MAIN_OFFSET 0x8000u
+#define PART_END 0x40000u
+#define MAIN_DEST 0xa0100000u
+#define INPUT_BUFFER 0xa1000000u
+#define OUT_LIMIT 0x100000u
+#define PAGE_SIZE 2048u
+#define OOB_SIZE 64u
+#define EBU 0xbe105300u
+#define NAND 0xb4000000u
+#define WAIT_POLLS 100000u
+#define SPL_CORRECTED 0xbe22fc00u
+#define SPL_ERROR 0xbe22fc04u
+enum { E_TIMEOUT=1, E_TPL_CRC, E_DDR, E_GEOMETRY, E_BADBLOCK,
+       E_ECC, E_HEADER, E_DATA_CRC, E_LZOP, E_DECODE, E_BOUNDS,
+       E_MEMORY=12,E_CLOCK,E_RAM_SIZE,E_PROBE,E_ALIAS,
+       E_STATE=17, E_ACCESS=18, E_REMAP=19,E_PLL=21,E_MAIN_CRC=28 };
+static inline u32 rd32(u32 a) { return *(volatile u32 *)(uintptr_t)a; }
+static inline void wr32(u32 a,u32 v) { *(volatile u32 *)(uintptr_t)a=v; }
+static inline u8 rd8(u32 a) { return *(volatile u8 *)(uintptr_t)a; }
+static inline void wr8(u32 a,u8 v) { *(volatile u8 *)(uintptr_t)a=v; }
+static inline u32 be32(const u8 *p) {
+ return ((u32)p[0]<<24)|((u32)p[1]<<16)|((u32)p[2]<<8)|p[3];
+}
+void *memcpy(void *,const void *,size_t);
+void *memset(void *,int,size_t);
+u32 crc32_bytes(const u8 *,u32);
+u32 adler32_bytes(const u8 *,u32);
+int wait_bits(u32,u32,u32);
+int nand_raw_page(u32,u8 *,u32);
+void nand_release(void);
+int soc_init(void);
+int clock_prepare(void);
+u32 memory_capacity(void);
+int memory_check(void);
+int ebu_prepare(void) __attribute__((noinline,noclone));
+int nand_setup(void);
+int nand_page_ecc(u32,u8 *);
+int nand_read_exact(u32,u32,u8 *);
+int decode_main(u8 *,u32,u8 *,u32 *);
+void fail(u32) __attribute__((noreturn,noinline,noclone));
+void handoff(void) __attribute__((noreturn));
+extern volatile u32 early_error, early_corrected;
+#endif
diff --git a/tools/p2812/early/ebu.c b/tools/p2812/early/ebu.c
new file mode 100644
index 00000000..b3da3776
--- /dev/null
+++ b/tools/p2812/early/ebu.c
@@ -0,0 +1,18 @@
+/* SPDX-License-Identifier: GPL-2.0+
+ * Historical VRX200 non-NOR ADDRSEL0.REGEN prerequisite, exercised by
+ * ROMSRAM3/4 in ROM UART SRAM. NAND-ROM inherited state remains modeled.
+ * Preserve all region1 timing/mapping and GPIO/NAND control registers.
+ */
+#include "early.h"
+int ebu_prepare(void) {
+ u32 before,target;
+ /* FPIM and EBU must already be accessible. Never enable a clock here.
+  * CLC.DISS bit1 is the conservative filter inherited from ROMSRAM4. */
+ if(rd32(0xbf102020u)&0x4400u)return E_ACCESS;
+ if(rd32(EBU)&2u)return E_ACCESS;
+ before=rd32(EBU+0x20);target=before&~1u;
+ if(rd32(EBU+0x20)!=before)return E_STATE;
+ if(before&1u)wr32(EBU+0x20,target);
+ if(rd32(EBU+0x20)!=target)return E_REMAP;
+ return 0;
+}
diff --git a/tools/p2812/early/image.c b/tools/p2812/early/image.c
new file mode 100644
index 00000000..d683e730
--- /dev/null
+++ b/tools/p2812/early/image.c
@@ -0,0 +1,38 @@
+/* SPDX-License-Identifier: GPL-2.0+ */
+#include "early.h"
+#include "generated.h"
+#include <linux/lzo.h>
+/* This deliberate narrow LZOP schema is exactly lzop -9 -c stdin output:
+ * v1.040, method3, level9, OS3, flags0x0d, empty name, one block, Adler32
+ * data and header, zero footer, no trailing bytes. Do not call upstream's
+ * unbounded parse_header/lzop_decompress container functions.
+ */
+int decode_main(u8 *image,u32 total,u8 *output,u32 *written) {
+ static const u8 magic[9]={0x89,0x4c,0x5a,0x4f,0,13,10,26,10};
+ u32 n,hcrc,crc,packed,raw,i;u8 *s;size_t cap;int rc;
+ *written=0;
+ if(total<64 || total>PART_END-MAIN_OFFSET)return E_BOUNDS;
+ if(be32(image)!=0x27051956 || be32(image+16)!=MAIN_DEST ||
+    be32(image+20)!=MAIN_DEST || image[28]!=17 || image[29]!=5 ||
+    image[30]!=5 || image[31]!=4)return E_HEADER;
+ hcrc=be32(image+4);memset(image+4,0,4);crc=crc32_bytes(image,64);
+ image[4]=hcrc>>24;image[5]=hcrc>>16;image[6]=hcrc>>8;image[7]=hcrc;
+ if(crc!=hcrc)return E_HEADER;
+ n=be32(image+12);if(n!=total-64)return E_BOUNDS;
+ s=image+64;if(crc32_bytes(s,n)!=be32(image+24))return E_DATA_CRC;
+ if(n<54)return E_LZOP;
+ for(i=0;i<9;i++)if(s[i]!=magic[i])return E_LZOP;
+ if(s[9]!=0x10||s[10]!=0x40||s[15]!=3||s[16]!=9 ||
+    be32(s+17)!=0x0300000d || s[33]!=0 ||
+    be32(s+34)!=adler32_bytes(s+9,25))return E_LZOP;
+ raw=be32(s+38);packed=be32(s+42);
+ if(!raw || raw>OUT_LIMIT || raw!=MAIN_BYTES || packed<3 ||
+    packed>raw || packed!=n-54 || be32(s+50+packed)!=0)return E_LZOP;
+ if(raw==packed)memcpy(output,s+50,raw);
+ else {
+  cap=raw;rc=lzo1x_decompress_safe(s+50,packed,output,&cap);
+  if(rc || cap!=raw)return E_DECODE;
+ }
+ if(adler32_bytes(output,raw)!=be32(s+46))return E_DECODE;
+ *written=raw;return 0;
+}
