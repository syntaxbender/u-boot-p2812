diff --git a/board/zyxel/p2812hnuf1/linux_run.c b/board/zyxel/p2812hnuf1/linux_run.c
new file mode 100644
index 00000000..99b24579
--- /dev/null
+++ b/board/zyxel/p2812hnuf1/linux_run.c
@@ -0,0 +1,217 @@
+// SPDX-License-Identifier: GPL-2.0+
+/* Manual fixed-layout Linux handoff. NAND access remains read-only. */
+#include <bootm.h>
+#include <command.h>
+#include <console.h>
+#include <image.h>
+#include <irq_func.h>
+#include <lmb.h>
+#include <linux/errno.h>
+#include <linux/sizes.h>
+#include <stdio.h>
+#include <asm/addrspace.h>
+#include <asm/global_data.h>
+#include <asm/mipsregs.h>
+#include <mach/p2812_linux.h>
+#include "nand_kernel.h"
+
+DECLARE_GLOBAL_DATA_PTR;
+
+#define KERNEL_LOAD 0x80002000UL
+#define KERNEL_INPUT 0xa2000000UL
+
+/* Record ownership at the allocation site, independently of mutable images.
+ * A failed release is retained and prevents a later attempt hiding the leak.
+ */
+static struct {
+	phys_addr_t address;
+	phys_size_t size;
+	bool owned;
+	bool tracking;
+	bool duplicate;
+} kernel_reservation;
+
+void p2812_linux_lmb_record(phys_addr_t address, phys_size_t size)
+{
+	if (!kernel_reservation.tracking)
+		return;
+	if (kernel_reservation.owned) {
+		kernel_reservation.duplicate = true;
+		return;
+	}
+	kernel_reservation.address = address;
+	kernel_reservation.size = size;
+	kernel_reservation.owned = true;
+}
+
+static int linux_context_ok(void)
+{
+	if (gd->ram_size < SZ_128M ||
+	    (read_c0_config() & CONF_CM_CMASK) != 3)
+		return -ENOTSUPP;
+	return 0;
+}
+
+static int linux_image_ok(u32 declared)
+{
+	if (images.os.load != KERNEL_LOAD || images.ep != KERNEL_LOAD ||
+	    images.os.os != IH_OS_LINUX || images.os.arch != IH_ARCH_MIPS ||
+	    images.os.type != IH_TYPE_KERNEL || images.os.comp != IH_COMP_LZMA ||
+	    images.rd_start || images.rd_end || images.ft_len ||
+	    !declared || declared > CONFIG_SYS_BOOTM_LEN)
+		return -EBADMSG;
+	return 0;
+}
+
+static int linux_run(bool from_nand)
+{
+	struct bootm_info bmi;
+	const char *stage = "unreleased reservation";
+	const u8 *size;
+	u32 declared;
+	ulong iflag = 0;
+	int ret = -EBUSY;
+	long cleanup;
+
+	if (kernel_reservation.owned) {
+		p2812_nand_kernel_invalidate();
+		puts("Previous Linux output reservation retained; new attempt blocked\n");
+		return CMD_RET_FAILURE;
+	}
+	kernel_reservation.duplicate = false;
+	stage = "CPU/RAM context";
+	ret = linux_context_ok();
+	if (ret)
+		goto error;
+	stage = "cancelled";
+	ret = -EINTR;
+	if (ctrlc())
+		goto error;
+	stage = from_nand ? "NAND read/verify" : "RAM image verify";
+	ret = from_nand ? p2812_nand_kernel_load() : p2812_ram_kernel_verify();
+	if (ret)
+		goto error;
+	size = (const u8 *)KERNEL_INPUT + sizeof(struct legacy_img_hdr) + 5;
+	declared = (u32)size[0] | (u32)size[1] << 8 |
+		   (u32)size[2] << 16 | (u32)size[3] << 24;
+	stage = "cancelled";
+	ret = -EINTR;
+	if (ctrlc())
+		goto error;
+	bootm_init(&bmi);
+	bmi.addr_img = "a2000000";
+	bmi.conf_ramdisk = "-";
+	bmi.conf_fdt = NULL;
+	bmi.cmd_name = from_nand ? "nandbootrun" : "rambootrun";
+	bmi.boot_progress = false;
+	stage = "bootm start";
+	ret = bootm_run_states(&bmi, BOOTM_STATE_START |
+			      BOOTM_STATE_FINDOS | BOOTM_STATE_FINDOTHER);
+	if (ret)
+		goto error;
+	stage = "kernel identity";
+	ret = linux_image_ok(declared);
+	if (ret)
+		goto error;
+	stage = "cancelled";
+	ret = -EINTR;
+	if (ctrlc())
+		goto error;
+	/* The upstream decoder writes before allocating its output reservation. */
+	stage = "free output window";
+	ret = -EBUSY;
+	if (lmb_get_free_size(CKSEG1ADDR(KERNEL_LOAD)) < CONFIG_SYS_BOOTM_LEN)
+		goto error;
+	stage = "bootm loados";
+	kernel_reservation.tracking = true;
+	ret = bootm_run_states(&bmi, BOOTM_STATE_LOADOS);
+	kernel_reservation.tracking = false;
+	if (ret)
+		goto error;
+	stage = "decoded identity/reservation";
+	ret = linux_image_ok(declared);
+	if (ret)
+		goto error;
+	ret = -EBADMSG;
+	if (!kernel_reservation.owned || kernel_reservation.duplicate ||
+	    kernel_reservation.address != CKSEG1ADDR(KERNEL_LOAD) ||
+	    kernel_reservation.size != declared ||
+	    images.os.image_len != declared)
+		goto error;
+	stage = "cancelled";
+	ret = -EINTR;
+	if (ctrlc())
+		goto error;
+	stage = "bootm prep";
+	ret = bootm_run_states(&bmi, BOOTM_STATE_OS_PREP);
+	if (ret)
+		goto error;
+	stage = "final CPU/RAM context";
+	ret = linux_context_ok();
+	if (ret)
+		goto error;
+	stage = "final kernel identity";
+	ret = linux_image_ok(declared);
+	if (ret)
+		goto error;
+	if (images.os.image_len != declared || !kernel_reservation.owned) {
+		ret = -EBADMSG;
+		goto error;
+	}
+	stage = "cancelled";
+	ret = -EINTR;
+	if (ctrlc())
+		goto error;
+	printf("P2812 Linux handoff: source=%s decoded=%u entry=%08lx\n",
+	       from_nand ? "NAND" : "RAM", declared, KERNEL_LOAD);
+	stage = "Linux returned";
+	/* LOADOS restores its saved interrupt state before returning. Separate
+	 * PREP/GO calls therefore need an explicit final interrupt handoff.
+	 */
+	iflag = disable_interrupts();
+	ret = bootm_run_states(&bmi, BOOTM_STATE_OS_GO);
+	if (!ret)
+		ret = -EIO;
+error:
+	kernel_reservation.tracking = false;
+	if (iflag)
+		enable_interrupts();
+	if (kernel_reservation.owned) {
+		cleanup = lmb_free(kernel_reservation.address,
+				   kernel_reservation.size, LMB_NONE);
+		if (!cleanup)
+			kernel_reservation.owned = false;
+		else
+			printf("Linux output reservation retained (%ld); new attempts blocked\n",
+			       cleanup);
+	}
+	p2812_nand_kernel_invalidate();
+	printf("P2812 Linux boot stopped: %s (%d); image invalidated; staying at console\n",
+	       stage, ret);
+	return CMD_RET_FAILURE;
+}
+
+static int do_nandbootrun(struct cmd_tbl *cmdtp, int flag, int argc,
+			  char *const argv[])
+{
+	if (argc != 1)
+		return CMD_RET_USAGE;
+	return linux_run(true);
+}
+
+static int do_rambootrun(struct cmd_tbl *cmdtp, int flag, int argc,
+			 char *const argv[])
+{
+	if (argc != 1)
+		return CMD_RET_USAGE;
+	return linux_run(false);
+}
+
+U_BOOT_CMD(nandbootrun, 1, 0, do_nandbootrun,
+	   "read/verify fixed NAND kernel and execute Linux",
+	   "No arguments. Kernel 60000..560000; input a2000000; entry 80002000.\n"
+	   "NAND reader is read-only; the Linux kernel may access/write NAND.");
+U_BOOT_CMD(rambootrun, 1, 0, do_rambootrun,
+	   "verify fixed RAM kernel and execute Linux",
+	   "No arguments. Input a2000000, max 16 MiB; entry 80002000.\n"
+	   "Does not read NAND; Linux access depends on the supplied kernel/DTB.");
diff --git a/board/zyxel/p2812hnuf1/nand_bootcheck.c b/board/zyxel/p2812hnuf1/nand_bootcheck.c
new file mode 100644
index 00000000..55395a98
--- /dev/null
+++ b/board/zyxel/p2812hnuf1/nand_bootcheck.c
@@ -0,0 +1,108 @@
+// SPDX-License-Identifier: GPL-2.0+
+/* Interruptible autoboot rehearsal: read, verify and decompress, then stop. */
+#include <bootm.h>
+#include <command.h>
+#include <console.h>
+#include <image.h>
+#include <lmb.h>
+#include <linux/errno.h>
+#include <stdio.h>
+#include <asm/addrspace.h>
+#include "nand_kernel.h"
+
+static int do_nandbootcheck(struct cmd_tbl *cmdtp, int flag, int argc,
+			    char *const argv[])
+{
+	struct bootm_info bmi;
+	const char *stage = "cancelled";
+	const u8 *size;
+	u32 declared;
+	ulong actual;
+	int ret = -EINTR;
+	long cleanup;
+
+	if (argc != 1)
+		return CMD_RET_USAGE;
+	p2812_nand_kernel_invalidate();
+	if (ctrlc())
+		goto error;
+	stage = "NAND read/verify";
+	ret = p2812_nand_kernel_load();
+	if (ret)
+		goto error;
+	/* The reader already validated this LZMA-Alone declared size. */
+	size = (const u8 *)0xa2000000UL + sizeof(struct legacy_img_hdr) + 5;
+	declared = (u32)size[0] | (u32)size[1] << 8 |
+		   (u32)size[2] << 16 | (u32)size[3] << 24;
+	stage = "cancelled";
+	ret = -EINTR;
+	if (ctrlc())
+		goto error;
+	bootm_init(&bmi);
+	bmi.addr_img = "a2000000";
+	bmi.conf_ramdisk = "-";
+	/* No external FDT selector: the legacy MIPS kernel carries its DTB.
+	 * A literal "-" here is parsed as an external address by boot_get_fdt().
+	 */
+	bmi.conf_fdt = NULL;
+	bmi.cmd_name = "nandbootcheck";
+	bmi.boot_progress = false;
+	stage = "bootm start";
+	ret = bootm_run_states(&bmi, BOOTM_STATE_START |
+			      BOOTM_STATE_FINDOS | BOOTM_STATE_FINDOTHER);
+	if (ret)
+		goto error;
+	stage = "cancelled";
+	ret = -EINTR;
+	if (ctrlc())
+		goto error;
+	/* Decoder writes happen before upstream reserves the output. Require the
+	 * full possible output window to be free before touching that RAM.
+	 */
+	stage = "RAM reservation";
+	ret = -EBUSY;
+	if (lmb_get_free_size(CKSEG1ADDR(0x80002000UL)) < CONFIG_SYS_BOOTM_LEN)
+		goto error;
+	stage = "bootm loados";
+	ret = bootm_run_states(&bmi, BOOTM_STATE_LOADOS);
+	if (ret)
+		goto error;
+	/* Successful LOADOS owns exactly this reservation. Release it so
+	 * a repeated check does not retain kernel memory in the global LMB.
+	 * Do not free anything on a failed LOADOS (reservation may not be ours).
+	 */
+	stage = "decoded bounds";
+	actual = images.os.image_len;
+	if (images.os.load != 0x80002000UL || !actual ||
+	    actual > CONFIG_SYS_BOOTM_LEN) {
+		ret = -EFBIG;
+		goto error;
+	}
+	cleanup = lmb_free(CKSEG1ADDR(images.os.load), actual, LMB_NONE);
+	if (cleanup) {
+		stage = "LMB release";
+		ret = cleanup;
+		goto error;
+	}
+	if (actual != declared) {
+		stage = "decoded size";
+		ret = -EBADMSG;
+		goto error;
+	}
+	/* Invalidate even on success: manual GO must not reuse rehearsal state. */
+	p2812_nand_kernel_invalidate();
+	printf("NAND boot check passed: decoded=%lu; Linux not executed; image invalidated; staying at console\n",
+	       actual);
+	return CMD_RET_SUCCESS;
+error:
+	p2812_nand_kernel_invalidate();
+	printf("NAND boot check stopped: %s (%d); image invalidated; staying at console\n",
+	       stage, ret);
+	return CMD_RET_FAILURE;
+}
+
+U_BOOT_CMD(nandbootcheck, 1, 0, do_nandbootcheck,
+	   "rehearse fixed NAND kernel boot without executing Linux (read only)",
+	   "No arguments. Reads/verifies NAND, runs bootm start and loados only.\n"
+	   "On success or error invalidates the image and returns to console.\n"
+	   "No automatic retry, reset, Linux execution or persistent modification.");
diff --git a/board/zyxel/p2812hnuf1/nand_kernel.c b/board/zyxel/p2812hnuf1/nand_kernel.c
new file mode 100644
index 00000000..6ff4dc3c
--- /dev/null
+++ b/board/zyxel/p2812hnuf1/nand_kernel.c
@@ -0,0 +1,209 @@
+// SPDX-License-Identifier: GPL-2.0+
+/* Fixed-layout NAND kernel reader. No decompression, execution or flash writes. */
+#include <command.h>
+#include <image.h>
+#include <linux/errno.h>
+#include <linux/mtd/mtd.h>
+#include <linux/string.h>
+#include <stdio.h>
+#include <u-boot/crc.h>
+#include <mach/nand_ro.h>
+#include "nand_kernel.h"
+
+#define KERNEL_START 0x00060000U
+#define KERNEL_END 0x00560000U
+#define KERNEL_CAPACITY (KERNEL_END - KERNEL_START)
+#define KERNEL_RAM 0xa2000000UL
+#define KERNEL_ENTRY 0x80002000U
+#define PAGE_BYTES 2048U
+#define ERASE_BYTES 0x20000U
+#define LZMA_HEADER_BYTES 13U
+
+struct kernel_reader {
+	u32 offset;
+	u32 checked_block;
+	u32 pages;
+	u32 skipped;
+};
+
+static u8 kernel_page[PAGE_BYTES] __aligned(4);
+static u8 kernel_oob[64];
+
+/* Bad blocks consume physical partition space, never the next partition. */
+static int kernel_next_page(struct kernel_reader *reader)
+{
+	int ret;
+	u32 block;
+
+	while (reader->offset < KERNEL_END) {
+		block = reader->offset & ~(ERASE_BYTES - 1);
+		if (block != reader->checked_block) {
+			ret = ltq_nand_ro_isbad(block);
+			if (ret < 0)
+				return ret;
+			if (ret) {
+				reader->skipped++;
+				reader->offset = block + ERASE_BYTES;
+				continue;
+			}
+			reader->checked_block = block;
+		}
+		ret = ltq_nand_ro_read_page(reader->offset, false,
+					  kernel_page, kernel_oob);
+		if (ret)
+			return ret;
+		reader->offset += PAGE_BYTES;
+		reader->pages++;
+		return 0;
+	}
+	return -ENOSPC;
+}
+
+static u32 kernel_le32(const u8 *p)
+{
+	return (u32)p[0] | (u32)p[1] << 8 | (u32)p[2] << 16 | (u32)p[3] << 24;
+}
+
+static int kernel_check_header(const struct legacy_img_hdr *header,
+			       u32 capacity, u32 *total, u32 *output)
+{
+	const u8 *lzma = (const u8 *)header + sizeof(*header);
+	u32 payload, dictionary, lc, lp;
+
+	if (!image_check_magic(header) || !image_check_hcrc(header))
+		return -EBADMSG;
+	if (!image_check_os(header, IH_OS_LINUX) ||
+	    !image_check_arch(header, IH_ARCH_MIPS) ||
+	    !image_check_type(header, IH_TYPE_KERNEL) ||
+	    image_get_comp(header) != IH_COMP_LZMA ||
+	    image_get_load(header) != KERNEL_ENTRY ||
+	    image_get_ep(header) != KERNEL_ENTRY)
+		return -ENOTSUPP;
+	payload = image_get_data_size(header);
+	/* Subtract before adding so a hostile 32-bit size cannot wrap. */
+	if (payload <= LZMA_HEADER_BYTES ||
+	    payload > capacity - sizeof(*header))
+		return -EFBIG;
+	if (lzma[0] >= 9 * 5 * 5)
+		return -ENOTSUPP;
+	lc = lzma[0] % 9;
+	lp = (lzma[0] / 9) % 5;
+	dictionary = kernel_le32(lzma + 1);
+	/* Keep decoder allocation bounded, and require a declared output size. */
+	if (lc + lp > 4 || dictionary < 4096 ||
+	    dictionary > CONFIG_SYS_BOOTM_LEN || kernel_le32(lzma + 9))
+		return -ENOTSUPP;
+	*output = kernel_le32(lzma + 5);
+	if (!*output || *output > CONFIG_SYS_BOOTM_LEN)
+		return -EFBIG;
+	*total = sizeof(*header) + payload;
+	return 0;
+}
+
+void p2812_nand_kernel_invalidate(void)
+{
+	/* Invalidate stale input and stale bootm state, including after a failure.
+	 * A new successful bootm start is required before any later bootm stage.
+	 */
+	memset((void *)KERNEL_RAM, 0, sizeof(struct legacy_img_hdr));
+	memset(&images, 0, sizeof(images));
+	images.state = BOOTM_STATE_OS_GO;
+}
+
+int p2812_nand_kernel_load(void)
+{
+	struct kernel_reader reader = { KERNEL_START, ~0U, 0, 0 };
+	struct legacy_img_hdr *header = (void *)KERNEL_RAM;
+	struct mtd_info *mtd;
+	u32 total = 0, output = 0, done, take, corrected;
+	int ret;
+
+	p2812_nand_kernel_invalidate();
+	ret = ltq_nand_ro_probe();
+	if (ret)
+		goto error;
+	mtd = ltq_nand_ro_mtd();
+	if (!mtd || mtd->size != 0x08000000ULL ||
+	    mtd->writesize != PAGE_BYTES || mtd->oobsize != 64 ||
+	    mtd->erasesize != ERASE_BYTES || (mtd->flags & MTD_WRITEABLE)) {
+		ret = -ENOTSUPP;
+		goto error;
+	}
+	corrected = mtd->ecc_stats.corrected;
+	ret = kernel_next_page(&reader);
+	if (ret)
+		goto error;
+	ret = kernel_check_header((const void *)kernel_page, KERNEL_CAPACITY,
+				  &total, &output);
+	if (ret)
+		goto error;
+	for (done = 0; done < total; done += take) {
+		if (done) {
+			ret = kernel_next_page(&reader);
+			if (ret)
+				goto error;
+		}
+		take = total - done;
+		if (take > PAGE_BYTES)
+			take = PAGE_BYTES;
+		memcpy((u8 *)header + done, kernel_page, take);
+	}
+	/* Always verify data CRC, regardless of the environment's verify flag. */
+	if (!image_check_dcrc(header)) {
+		ret = -EBADMSG;
+		goto error;
+	}
+	printf("NAND kernel verified: ram=%08lx bytes=%u CRC32=%08x dataCRC=%08x\n",
+	       KERNEL_RAM, total, crc32(0, (const u8 *)header, total),
+	       image_get_dcrc(header));
+	printf("NAND kernel bounds: partition=%08x..%08x physical_end=%08x pages=%u skipped=%u corrected=%u\n",
+	       KERNEL_START, KERNEL_END, reader.offset, reader.pages,
+	       reader.skipped, mtd->ecc_stats.corrected - corrected);
+	printf("NAND kernel LZMA: output=%u load=%08x entry=%08x limit=%u\n",
+	       output, KERNEL_ENTRY, KERNEL_ENTRY, CONFIG_SYS_BOOTM_LEN);
+	puts("NAND kernel ready in RAM; Linux not executed\n");
+	return CMD_RET_SUCCESS;
+error:
+	p2812_nand_kernel_invalidate();
+	printf("NAND kernel load failed: %d; image invalidated; staying at console\n",
+	       ret);
+	return CMD_RET_FAILURE;
+}
+
+static int do_nandkload(struct cmd_tbl *cmdtp, int flag, int argc,
+			char *const argv[])
+{
+	if (argc != 1)
+		return CMD_RET_USAGE;
+	return p2812_nand_kernel_load();
+}
+
+#ifdef CONFIG_CMD_P2812_LINUXRUN
+int p2812_ram_kernel_verify(void)
+{
+	const struct legacy_img_hdr *header = (const void *)KERNEL_RAM;
+	u32 total, output;
+	int ret;
+
+	/* Preserve the freshly loaded input; clear only prior bootm state. */
+	memset(&images, 0, sizeof(images));
+	images.state = BOOTM_STATE_OS_GO;
+	ret = kernel_check_header(header, 0x1000000U, &total, &output);
+	if (!ret && !image_check_dcrc(header))
+		ret = -EBADMSG;
+	if (ret) {
+		p2812_nand_kernel_invalidate();
+		printf("RAM kernel verify failed: %d; image invalidated\n", ret);
+		return CMD_RET_FAILURE;
+	}
+	printf("RAM kernel verified: ram=%08lx bytes=%u output=%u\n",
+	       KERNEL_RAM, total, output);
+	return CMD_RET_SUCCESS;
+}
+#endif
+
+U_BOOT_CMD(nandkload, 1, 0, do_nandkload,
+	   "read and verify P2812 NAND kernel to fixed RAM (read only)",
+	   "No arguments. Kernel partition 60000..560000, RAM a2000000.\n"
+	   "Skips bad blocks within partition; checks ECC, header/data CRC and bounds.\n"
+	   "Does not decompress or execute Linux. Use fresh bootm start afterwards.");
