+  elif address==0x1f4010f0:setword(address,(word(address)&~0x0f000000)|(0 if mode=='invalid_capacity' else 12<<24))
+  elif address==0x1f401100:setword(address,(word(address)&~15)|14|0x04000000)
+  elif address==0x1f10300c:
